#!/bin/sh
# /etc/uci-defaults/99-netcontrol
#
# Runs once on the first boot after an install, or after a sysupgrade that kept
# an older configuration. It only backfills options the views assume exist and
# registers the init script; rule enforcement stays entirely in the
# luci.netcontrol ubus object.

GLOBAL=netcontrol.global

uci -q show $GLOBAL >/dev/null 2>&1 || uci -q set $GLOBAL=netcontrol

set_default() {
	uci -q get $GLOBAL.$1 >/dev/null 2>&1 || uci -q set $GLOBAL.$1="$2"
}

set_default enabled 1
set_default watchdog_interval 3
set_default eval_interval 60
set_default timezone Asia/Shanghai

uci -q commit netcontrol

/etc/init.d/netcontrol enable
/etc/init.d/netcontrol start

exit 0
