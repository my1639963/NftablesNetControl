#!/usr/bin/ucode
// luci.netcontrol - rpcd ucode backend
//
// Every kernel-side mutation (nftables) and every generated artifact (cron)
// funnels through this single object. rpcd serialises ubus calls, which is
// what keeps the boot handler, cron, hotplug and the LuCI UI from racing each
// other - the legacy flock wrapper is gone with it.
//
// UCI itself is edited by the LuCI views through form.Map; this object only
// creates the sections behind the quick-action buttons and then converges the
// kernel onto whatever UCI says (apply).
//
// Manual control (manualSet / manualDelete) is a state machine event like any
// other: it writes a persistent row for the table, then pushes the device into
// the requested state right away through the same entry point the clock uses.
// It never edits, pauses or cancels a time rule, so its effect lasts until the
// next event of that device - which is why deleting the row is itself an event:
// it hands the device back to whatever the time layer currently says.
//
// Time rules are two moments, nothing more. A rule's start applies its own
// target and its end applies the opposite; the engine never compares one
// rule's window against another's, so overlapping windows flip the state back
// and forth and the operator owns that. Every applied event is logged even when
// the state did not change - an executed event is not the same as a flip.
//
// The resulting per device state lives in config timerstate and the kernel
// chain is converged onto it. Every mutation in this object ends in a UCI
// commit inside the same call, so the UI can never show unsaved changes.

'use strict';

import { access, popen, readfile, writefile } from 'fs';
import { cursor } from 'uci';
import { init_action } from 'luci.sys';

const CFG = 'netcontrol';
const DEFAULT_TIMEZONE = 'Asia/Shanghai';
const TABLE = 'inet netcontrol';
const CHAIN = 'nc_forward';
const NFT_BIN = '/usr/sbin/nft';
const CT_BIN = '/usr/sbin/conntrack';
const CRON_FILE = '/etc/crontabs/root';
const UBUS_TIMERULES = '/bin/ubus call luci.netcontrol timerules';
const UBUS_WATCHDOG = '/bin/ubus call luci.netcontrol watchdog';
/* Staged in the same directory as the target: a rename only stays atomic while
 * both ends share one filesystem, and /tmp is tmpfs. */
const CRON_TMP = `${CRON_FILE}.tmp`;
const CRON_TAG = '# netcontrol:';
const DAEMON_PID = '/tmp/run/netcontrol_eval.pid';
const DAEMON_TICK = '/tmp/run/netcontrol_eval.tick';
const TICK_FILE = '/tmp/run/netcontrol.last_tick';
const LEASES = '/tmp/dhcp.leases';
const ARP = '/proc/net/arp';
const CLOCK_BASELINE = 1735689600;

/* Ucode's regex has no (?:...) groups, so an address is spelled out once here
 * and pasted into every pattern that has to recognise one in command output.
 * Upper case hex is accepted because /proc and `ip neigh` are not guaranteed
 * to fold it; norm_mac() still canonicalises to lower case afterwards.
 * A pattern given to regexp() is plain POSIX ERE, where a bracket expression
 * does not understand \t: separators are spelled [[:space:]] there. */
const MAC_OCTETS = '[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}' +
	':[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}';

const MIN_EVAL_INTERVAL = 60;
const DEFAULT_EVAL_INTERVAL = 60;
const MIN_WATCHDOG_INTERVAL = 1;
/* crond's minute field accepts a step of 1..59 only. A step of 60 is an out of
 * range expression whose handling is unspecified, so the ceiling has to stay
 * below a full hour for the generated line to mean what it says. */
const MAX_WATCHDOG_INTERVAL = 30;
const DEFAULT_WATCHDOG_INTERVAL = 3;

/* A dead loop must not replay more than a day of events when it comes back. */
const MAX_TICK_MINUTES = 1440;

/* How far back deleting a manual row replays the clock to find where the device
 * belongs. One month, because that is the longest cycle a rule can have: a
 * single moment rule set for the 1st only acts once a month, so a shorter frame
 * would report "no rule applies" for three weeks out of four. */
const RESTORE_SCAN_DAYS = 31;

/* How far the preview looks for a rule's next event. A monthly rule on day 31
 * can be 59 days out (February to March), so the frame is walked a month
 * longer than that; one `date` probe per day makes the horizon cheap. */
const NEXT_EVENT_DAYS = 70;

/* Every cycle short of monthly repeats inside a week, so a frame of eight days
 * already holds the next moment of a daily or weekly rule. Used whenever no
 * rule asks for a monthly day, because the long frame costs one `date` fork per
 * day and that is what makes the preview slow. */
const SHORT_EVENT_DAYS = 8;

/* The cron tick is a backstop for a dead evaluation loop, not the driver, so it
 * is deliberately coarse: BusyBox crond logs one syslog line per job it spawns,
 * and a per minute tick from this package used to fill a third of the visible
 * log ring on its own. */
const CRON_BACKSTOP_MINUTES = 5;

/* The loop has to wake at least as often as the backstop that exists to cover
 * it: let it sleep past the cron tick and cron silently becomes the driver while
 * the pages still report the loop's own longer interval. */
const MAX_EVAL_INTERVAL = CRON_BACKSTOP_MINUTES * 60;

const uci = cursor();

/* ── primitives ───────────────────────────────────────── */

function is_set(v) {
	return (v ?? null) !== null;
}

/* fs.access() yields null on any error, so normalise it for JSON responses. */
function has(path, mode) {
	return is_set(access(path, mode));
}

/* ucode's join() takes the separator first; wrap it so call sites read naturally. */
function strjoin(items, sep) {
	if (!is_set(items))
		return '';

	return join(sep ?? '', items);
}

/* This ucode build has no some()/every(). */
function any(items, test) {
	for (let v in items)
		if (test(v))
			return true;

	return false;
}

function first(list, test) {
	for (let it in list)
		if (test(it))
			return it;

	return null;
}

function to_int(value, fallback) {
	if (!is_set(value))
		return fallback;

	const m = match(`${value}`, /^-?[0-9]+$/);

	return m ? m[0] * 1 : fallback;
}

function clamp_int(value, fallback, low, high) {
	const n = to_int(value, fallback) | 0;

	if (n < low)
		return low;

	if (n > high)
		return high;

	return n;
}

function shellquote(value) {
	const s = is_set(value) ? `${value}` : '';

	return `'${replace(s, "'", `'\\''`)}'`;
}

function run(cmd) {
	const fd = popen(cmd, 'r');

	if (!fd)
		return { out: '', rc: 1 };

	const out = fd.read('all') ?? '';
	const rc = fd.close();

	return { out, rc: rc ?? 1 };
}

function log(priority, message) {
	run(`logger -t netcontrol -p daemon.${priority} ${shellquote(message)}`);
}

function is_bool(value, fallback) {
	if (!is_set(value))
		return fallback;

	return `${value}` !== '0' && `${value}` !== 'false';
}

/* MACs are canonical lower-case everywhere: UCI, nftables and the UI all
 * compare the same representation. */
function norm_mac(value) {
	const hex = replace(lc(`${value ?? ''}`), /[^0-9a-f]/g, '');

	if (match(hex, /^[0-9a-f]{12}$/) === null)
		return null;

	return strjoin([
		substr(hex, 0, 2), substr(hex, 2, 2), substr(hex, 4, 2),
		substr(hex, 6, 2), substr(hex, 8, 2), substr(hex, 10, 2)
	], ':');
}

function is_ipv4(value) {
	const m = match(`${value ?? ''}`, /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/);

	if (!m)
		return false;

	for (let i = 1; i <= 4; i++)
		if (m[i] * 1 > 255)
			return false;

	return true;
}

function is_timezone(value) {
	return match(`${value ?? ''}`, /^[A-Za-z0-9_+\/-]+$/) !== null &&
		has(`/usr/share/zoneinfo/${value}`, "r");
}

function is_section_id(value) {
	return match(`${value ?? ''}`, /^[A-Za-z0-9_-]+$/) !== null;
}

/* The nft comment carries a UCI section name. Those are generated safe, but a
 * hand edited config is still operator input, and one stray quote would break
 * the whole batch script. */
function safe_tag(value) {
	return replace(`${value ?? ''}`, /[^A-Za-z0-9_:-]/g, '-');
}

/* ── uci ──────────────────────────────────────────────── */

function load_cfg() {
	uci.load(CFG);
}

function get_global(option, fallback) {
	const v = uci.get(CFG, 'global', option);

	return is_set(v) && v !== '' ? `${v}` : fallback;
}

/* null means "fall back to the system local timezone": OpenWrt stores a POSIX
 * zone string in /etc/TZ and the zoneinfo tree is an optional package, so an
 * unresolved IANA name must not silently evaluate rules in UTC. */
function timezone_value() {
	return get_global('timezone', DEFAULT_TIMEZONE);
}

function timezone() {
	const tz = timezone_value();

	return is_timezone(tz) ? tz : null;
}

function global_enabled() {
	return get_global('enabled', '1') !== '0';
}

function sections(type) {
	const out = [];

	uci.foreach(CFG, type, function (s) {
		push(out, s);
	});

	return out;
}

function set_option(section, option, value) {
	uci.set(CFG, section, option, value);
}

function persist() {
	if (!uci.commit(CFG)) {
		log('err', 'UCI commit failed');
		return false;
	}

	return true;
}

/* ── time ─────────────────────────────────────────────── */

function tz_prefix(tz) {
	return tz === null ? '' : `TZ=${shellquote(tz)} `;
}

function local_parts(tz, epoch) {
	const res = run(`${tz_prefix(tz)}date -d @${epoch} '+%u %d %H %M %S' 2>/dev/null`);
	const m = match(trim(res.out), /^([0-9]) ([0-9]{2}) ([0-9]{2}) ([0-9]{2}) ([0-9]{2})$/);

	if (!m)
		return null;

	return {
		dow: m[1] * 1,
		day: m[2] * 1,
		hour: m[3] * 1,
		min: m[4] * 1,
		sec: m[5] * 1,
		total: m[3] * 1 * 60 + m[4] * 1
	};
}

function utc_parts(epoch) {
	return local_parts('UTC', epoch);
}

function iso_now(tz) {
	return trim(run(`${tz_prefix(tz)}date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null`).out);
}

function clock_ok() {
	return time() >= CLOCK_BASELINE;
}

/* One `date` probe per call: nothing reads the parts, it only asks whether this
 * clock and zone can be read at all, and status() is polled every 15 seconds, so
 * the second probe was a fork the router paid all day for a boolean.
 *
 * The UTC probe is not timezone() falling through: an unsynchronised clock has no
 * meaningful local time at all, so the parts are read in the one zone that cannot
 * be wrong. A zone that does not resolve keeps the system local zone, which is
 * what timezone() documents. */
function clock_context() {
	const tz = timezone();
	const epoch = time();
	let now = local_parts(tz, epoch);

	if (!clock_ok() || now === null)
		now = utc_parts(epoch);

	return { tz, epoch, ok: now !== null };
}

/* ── nftables ─────────────────────────────────────────── */

function nft_available() {
	return has(NFT_BIN, "x");
}

function kernel_presence() {
	const res = run(`${NFT_BIN} list table ${TABLE} 2>/dev/null`);

	return {
		table: res.rc === 0,
		chain: res.rc === 0 && index(res.out, `chain ${CHAIN} {`) >= 0
	};
}

function ensure_base() {
	if (!nft_available()) {
		log('err', 'nftables binary missing');
		return false;
	}

	/* One probe for both objects: rebuild() reaches this on every tick, and two
	 * separate `nft list` calls made the steady state cost more forks than the
	 * work it was doing. */
	const present = kernel_presence();

	if (!present.table && run(`${NFT_BIN} add table ${TABLE}`).rc !== 0) {
		log('err', 'failed to create table inet netcontrol');
		return false;
	}

	const chain_spec = `add chain ${TABLE} ${CHAIN} '{ type filter hook forward priority -10; policy accept; }'`;

	if (!present.chain && run(`${NFT_BIN} ${chain_spec}`).rc !== 0) {
		log('err', 'failed to create chain nc_forward');
		return false;
	}

	return true;
}

function chain_rules() {
	const out = run(`${NFT_BIN} list chain ${TABLE} ${CHAIN} 2>/dev/null`).out;
	const rules = [];
	const pattern = `^[[:space:]]*ether (saddr|daddr) (${MAC_OCTETS})` +
		' drop[[:space:]]';
	const re = regexp(pattern);

	/* Anchored to rule bodies, so the chain header and its declarations never
	 * enter the list. The comment is kept because rebuild() has to tell a
	 * re-owned block (same address, different rule named in the comment) from a
	 * kernel state that already matches the plan. */
	for (let line in split(out, '\n')) {
		const body = lc(line);
		const m = match(body, re);

		if (m === null)
			continue;

		const comment = match(body, /comment "([^"]*)"/);

		push(rules, {
			dir: m[1],
			mac: norm_mac(m[2]),
			comment: comment === null ? '' : comment[1]
		});
	}

	return rules;
}

/* The distinct addresses among a set of chain rules. The caller already has the
 * rules - status() needs the rule count from the same listing - so this takes
 * the list instead of forking `nft` again. */
function macs_in(rules) {
	const set = {};

	for (let r in rules)
		set[r.mac] = true;

	return sort(keys(set));
}

/* nft -f commits the whole script as one transaction, which removes the
 * allow-window a flush-then-add sequence would leave open and makes a failed
 * batch a no-op instead of a half-applied policy. */
function nft_apply(lines) {
	const script = strjoin(lines, '\n');

	return run(`printf '%s' ${shellquote(script)} | ${NFT_BIN} -f -`).rc === 0;
}

/* One blocked address is two rules - forward traffic has to go in either
 * direction - and the comment names the row an operator can find and edit.
 *
 * Lowercased on purpose: chain_rules() reads the kernel listing with the whole
 * line through lc(), so a comment that keeps any capital - a hand-named UCI
 * section is enough - would never compare equal, and every cycle would rewrite
 * the chain chasing a difference that does not exist. */
function block_comment(block) {
	return lc(safe_tag(`netcontrol:device:${block.section}:${block.rule_type}`));
}

function batch_lines(blocks) {
	const lines = [`flush chain ${TABLE} ${CHAIN}`];

	for (let b in blocks) {
		const comment = block_comment(b);

		push(lines, `add rule ${TABLE} ${CHAIN} ether saddr ${b.mac} drop comment "${comment}"`);
		push(lines, `add rule ${TABLE} ${CHAIN} ether daddr ${b.mac} drop comment "${comment}"`);
	}

	return lines;
}

/* "direction mac comment" per rule, sorted, for the kernel listing and for the
 * plan. rebuild() compares the two to decide whether a transaction is needed at
 * all, and status() reports the same comparison as `consistent` so the page, the
 * watchdog and the writer can never disagree about what drift is: an address-only
 * compare would call "one of a device's two directions was deleted" consistent,
 * and a count alone would not say which device moved. */
function kernel_fingerprint(rules) {
	return sort(map(rules, function (r) { return `${r.dir} ${r.mac} ${r.comment}`; }));
}

function plan_fingerprint(blocks) {
	const out = [];

	for (let b in blocks) {
		const comment = block_comment(b);

		push(out, `saddr ${b.mac} ${comment}`);
		push(out, `daddr ${b.mac} ${comment}`);
	}

	return sort(out);
}

function same_fingerprint(actual, want) {
	if (length(actual) !== length(want))
		return false;

	for (let i = 0; i < length(actual); i++)
		if (actual[i] !== want[i])
			return false;

	return true;
}

/* ── engine ───────────────────────────────────────────── */

function group_by(items, key) {
	const out = {};

	for (let it in items) {
		const mac = norm_mac(it[key]);

		if (mac === null)
			continue;

		if (!is_set(out[mac]))
			out[mac] = [];

		push(out[mac], it);
	}

	return out;
}

function merge(a, b) {
	const out = {};

	for (let k in keys(a))
		out[k] = a[k];

	for (let k in keys(b))
		out[k] = b[k];

	return out;
}

function contains_value(list, needle) {
	if (!is_set(list))
		return false;

	if (type(list) !== 'array')
		list = [list];

	for (let v in list)
		if (to_int(v, null) === needle)
			return true;

	return false;
}

function cycle_matches(rule, now) {
	switch (rule.cycle_type ?? 'daily') {
		case 'weekly':
			return contains_value(rule.day_values, now.dow);

		case 'monthly':
			return contains_value(rule.day_values, now.day);
	}

	return true;
}

/* Minutes since midnight, or null. Hand-edited UCI can hold 25:00, which a
 * plain regex would accept and the cross-midnight branch would then treat as
 * a real window. */
function hhmm_total(value) {
	const m = match(`${value ?? ''}`, /^([0-9]{1,2}):([0-9]{2})$/);

	if (!m || m[1] * 1 > 23 || m[2] * 1 > 59)
		return null;

	/* * 1 on every capture: ucode's + concatenates strings, so "120" + "00"
	 * would otherwise be "12000" instead of 150. */
	return m[1] * 60 + m[2] * 1;
}

function rule_target(rule) {
	return (rule.action ?? 'block') === 'allow' ? 'allow' : 'block';
}

function flip(target) {
	return target === 'allow' ? 'block' : 'allow';
}

/* The moments a rule owns. The start moment is required and runs the rule's own
 * action; the end moment is optional and runs the opposite one, so "block this
 * device every day at 10:00" is a complete rule rather than a half filled
 * window. A cross-midnight window - and the whole day flag, which is 00:00 to
 * the next 00:00 - places its end on the following day, so the cycle check for
 * that end keeps using the day the window started on. A window whose ends match
 * its start has no moments to run and yields nothing. */
function rule_window(rule) {
	if (is_bool(rule.all_day, false))
		return { valid: true, start: 0, end: 0, cross: true };

	const start = hhmm_total(rule.time_start);
	const end = hhmm_total(rule.time_end);

	if (start === null || start === end)
		return { valid: false, start: null, end: null, cross: false };

	return { valid: true, start, end, cross: end !== null && end < start };
}

function enabled_timerules() {
	const out = [];

	for (let r in sections('timerule')) {
		if (!is_bool(r.enabled, true) || norm_mac(r.device_mac) === null)
			continue;

		push(out, r);
	}

	return out;
}

function iso_at(tz, epoch) {
	return trim(run(`${tz_prefix(tz)}date -d @${epoch} '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null`).out);
}

/* Epoch of the local midnight owning this epoch: read from the printed hour,
 * minute and second rather than epoch division, so no floor() or daylight
 * saving arithmetic is needed. The seconds have to go too - a day frame built
 * with any remainder in it shifts every event of that day by the same amount,
 * and a tick that lands a second late then misses the minute for good. */
function local_midnight(tz, epoch) {
	const p = local_parts(tz, epoch);

	if (p === null)
		return null;

	return epoch - (p.hour * 3600 + p.min * 60 + p.sec);
}

function bucket_of(buckets, minute) {
	const key = `${minute}`;

	return is_set(buckets[key]) ? buckets[key] : [];
}

function push_bucket(buckets, minute, item) {
	const key = `${minute}`;

	if (!is_set(buckets[key]))
		buckets[key] = [];

	push(buckets[key], item);
}

/* The local midnights owning [from, to], oldest first, one entry per day
 * holding today's parts and the previous day's: a cross-midnight window's end
 * event runs on the following day but is filtered by the cycle of the day it
 * started on. One `date` probe per day - yesterday's answer is carried
 * forward, the previous day only needs probing once for the first entry. */
function day_range(tz, from, to, limit) {
	const out = [];
	let mid = local_midnight(tz, from);
	let pp = mid === null ? null : local_parts(tz, mid - 60);
	let guard = 0;

	while (mid !== null && pp !== null && mid <= to && guard < limit) {
		const p = local_parts(tz, mid + 60);

		if (p === null)
			break;

		push(out, { mid: mid, p: p, pp: pp });

		pp = p;

		/* Not mid + 86400: a local day is 23 or 25 hours across a DST switch and
		 * a fixed step would carry that error into every later day of the frame.
		 * 25 hours is guaranteed to land inside the next local day, and the
		 * midnight is re-derived from there. */
		mid = local_midnight(tz, mid + 90000);
		guard++;
	}

	return out;
}

/* Every event due in (from, to], oldest first. Within one minute an end runs
 * before a start, so a window closing at 10:00 cannot cancel one opening at
 * 10:00 before the operator sees the flip; inside the same group the UCI
 * section order decides. Rules are never compared against each other. */
function events_in_range(rules, from, to, tz) {
	const out = [];
	const days = day_range(tz, from, to, (((to - from) / 86400) | 0) + 2);

	for (let d in days) {
		const starts = {};
		const ends = {};

		for (let i = 0; i < length(rules); i++) {
			const r = rules[i];
			const w = rule_window(r);

			if (!w.valid)
				continue;

			const base = { mac: norm_mac(r.device_mac), section: r['.name'] };
			const endDay = w.cross ? d.pp : d.p;

			if (cycle_matches(r, d.p))
				push_bucket(starts, w.start,
					merge(base, { epoch: d.mid + w.start * 60, target: rule_target(r), kind: 'start' }));

			if (w.end !== null && cycle_matches(r, endDay))
				push_bucket(ends, w.end,
					merge(base, { epoch: d.mid + w.end * 60, target: flip(rule_target(r)), kind: 'end' }));
		}

		for (let t = 0; t < 1440; t++) {
			for (let e in bucket_of(ends, t))
				if (e.epoch > from && e.epoch <= to)
					push(out, e);

			for (let e in bucket_of(starts, t))
				if (e.epoch > from && e.epoch <= to)
					push(out, e);
		}
	}

	return out;
}

/* Where the clock would leave this device right now, computed the way tick()
 * computes it: replay the events that were due since the frame opened and keep
 * the last one. Sharing events_in_range() is the whole point - a second
 * evaluator is how the two answers drift apart, and a single moment rule owns no
 * interval for an interval based reader to find, so it used to be missed here
 * and a deleted manual row handed the device back as open. The scan reaches a
 * month back because a monthly rule can equally have acted a month ago.
 *
 * Only manual_delete() calls it: the running engine never asks what a window
 * means, it is told what to do by the events themselves.
 *
 * The two spans are not equal, and that seam is documented rather than closed.
 * This scans back RESTORE_SCAN_DAYS; tick() replays at most MAX_TICK_MINUTES of
 * backlog and lets anything older go, so after an evaluation loop that has been
 * dead for longer than a day, deleting a manual row can hand the device to a state
 * the loop itself would never have written. The scan is the wider of the two on
 * purpose - a deleted row has to be answered from the rules as they stand, and a
 * monthly rule that acted three weeks ago is part of what stands. */
function current_time_target(mac) {
	const ctx = clock_context();

	if (!ctx.ok)
		return { target: 'allow', source: 'none', section: null };

	const rules = filter(enabled_timerules(), function (r) {
		return norm_mac(r.device_mac) === mac;
	});

	if (!length(rules))
		return { target: 'allow', source: 'none', section: null };

	const back = ctx.epoch - RESTORE_SCAN_DAYS * 86400;
	const from = local_midnight(ctx.tz, back) ?? back;
	const events = events_in_range(rules, from, ctx.epoch, ctx.tz);

	if (!length(events))
		return { target: 'allow', source: 'none', section: null };

	const last = events[length(events) - 1];

	return { target: last.target, source: 'timer', section: last.section };
}

/* The first event a rule will produce after now, or null. The caller builds one
 * shared day frame (see NEXT_EVENT_DAYS) and every day of it precedes the next,
 * so the first day holding a candidate already answers the question. */
function rule_next_event(rule, tz, now, days) {
	const w = rule_window(rule);

	if (!w.valid)
		return null;

	for (let d in days) {
		let cand = null;
		const endDay = w.cross ? d.pp : d.p;

		if (cycle_matches(rule, d.p) && d.mid + w.start * 60 > now)
			cand = { epoch: d.mid + w.start * 60, target: rule_target(rule), kind: 'start' };

		if (w.end !== null && cycle_matches(rule, endDay)) {
			const endEpoch = d.mid + w.end * 60;

			if (endEpoch > now && (cand === null || endEpoch < cand.epoch))
				cand = { epoch: endEpoch, target: flip(rule_target(rule)), kind: 'end' };
		}

		if (cand !== null)
			return {
				epoch: cand.epoch,
				kind: cand.kind,
				target: cand.target,
				at: iso_at(tz, cand.epoch),
				minutes: ((cand.epoch - now) / 60) | 0
			};
	}

	return null;
}

/* The next-event record trimmed to the four fields the preview panel shows. */
function nextEventFrame(next) {
	if (next === null)
		return null;

	return { at: next.at, kind: next.kind, target: next.target, minutes: next.minutes };
}

/* ── reachability ─────────────────────────────────────── */

/* These four sit above the state machine on purpose: ucode resolves a sibling
 * function only if it was already declared, so tick() and rebuild() would abort
 * with "access to undeclared variable" if the helpers moved back down. */

function arp_table() {
	const data = readfile(ARP);
	const out = [];
	const re = regexp('^([0-9.]+)[[:space:]]+0x1[[:space:]]+0x[26][[:space:]]+' +
		`(${MAC_OCTETS})[[:space:]]+[^[:space:]]+[[:space:]]+([^[:space:]]+)`);

	if (!data)
		return out;

	for (let line in split(data, '\n')) {
		const m = match(lc(line), re);

		if (m && is_ipv4(m[1]) && m[2] !== '00:00:00:00:00:00')
			push(out, { ip: m[1], mac: norm_mac(m[2]), iface: m[3] });
	}

	return out;
}

/* The MACs the kernel chain currently holds, as a lookup: three readers only
 * ever ask "is this address in the chain", none of them wants the rule list. */
function kernel_holds() {
	const out = {};

	for (let r in chain_rules())
		out[r.mac] = true;

	return out;
}

/* The neighbour table answers "can this device be seen": reachability and the
 * address it was last seen on, one entry per MAC. */
function online_map(arp) {
	const out = {};

	for (let a in arp)
		out[a.mac] = a.ip;

	return out;
}

function lease_table() {
	const data = readfile(LEASES);
	const out = [];

	if (!data)
		return out;

	for (let line in split(data, '\n')) {
		const f = filter(split(line, ' '), function (x) { return x !== ''; });

		if (length(f) < 4)
			continue;

		const mac = norm_mac(f[1]);

		if (mac !== null)
			push(out, { mac, ip: f[2], hostname: f[3] === '*' ? null : f[3] });
	}

	return out;
}

function mac_to_ip(mac, arp, leases) {
	for (let l in leases)
		if (l.mac === mac)
			return l.ip;

	for (let a in arp)
		if (a.mac === mac)
			return a.ip;

	return null;
}

/* ── conntrack ────────────────────────────────────────── */

/* IPv4 only, and that is a real limit rather than an oversight: the addresses
 * this object can resolve for a MAC come from the v4 lease file and the v4
 * neighbour table, so there is no v6 address to hand the kernel. A blocked
 * device's established IPv6 flows therefore expire on their own. */
function clean_conntrack(ip) {
	if (!is_ipv4(ip) || !has(CT_BIN, "x"))
		return false;

	run(`${CT_BIN} -D --orig-src ${shellquote(ip)} >/dev/null 2>&1`);
	run(`${CT_BIN} -D --orig-dst ${shellquote(ip)} >/dev/null 2>&1`);

	return true;
}

/* ── state machine ────────────────────────────────────── */

/* config timerstate holds one row per device the engine has ever acted on and
 * is the only thing the kernel chain is converged onto. Time rules and manual
 * clicks are merely sources feeding it. */
function state_index() {
	const out = {};

	for (let s in sections('timerstate')) {
		const mac = norm_mac(s.mac);

		if (mac !== null)
			out[mac] = s['.name'];
	}

	return out;
}

/* The single entry point every state change goes through. Logging happens even
 * when the state did not move: an executed event is not the same as a flip. */
function apply_event(index, mac, target, source, section, when, ip) {
	let sec = index[mac] ?? null;

	if (sec === null) {
		sec = uci.add(CFG, 'timerstate');

		if (!is_set(sec))
			return false;

		index[mac] = sec;
	}

	const before = `${uci.get(CFG, sec, 'state') ?? ''}`;
	const label = is_set(section) && section !== '' ? ` ${section}` : '';
	/* A replayed backlog lands in the log several minutes after the moment it
	 * belongs to, so the line names that moment as well as the write time. */
	const moment = length(`${when}`) >= 16 ? ` @ ${substr(`${when}`, 11, 5)}` : '';
	const note = before === target ? ', state unchanged' : '';

	set_option(sec, 'mac', mac);
	set_option(sec, 'state', target);
	set_option(sec, 'source', source);
	set_option(sec, 'section', section ?? '');
	set_option(sec, 'at', when);

	if (is_set(ip))
		set_option(sec, 'ip', ip);
	else if (!is_set(uci.get(CFG, sec, 'ip')))
		set_option(sec, 'ip', 'unknown');

	log('info', `event ${mac} -> ${target} (${source}${label}${moment}${note})`);

	return true;
}

function read_last_tick() {
	const raw = trim(`${readfile(TICK_FILE) ?? ''}`);

	return match(raw, /^[0-9]+$/) === null ? null : raw * 1;
}

/* Bookkeeping lives in /tmp: committing a UCI option every minute would be a
 * thousand flash writes a day for a value that means nothing after a reboot. */
function write_last_tick(epoch) {
	run('mkdir -p /tmp/run >/dev/null 2>&1');
	writefile(TICK_FILE, `${epoch}\n`);
}

function tick() {
	load_cfg();

	const now = time();

	if (!clock_ok())
		return { ok: true, events: 0, skipped: 'clock' };

	/* While the global switch is off the clock stays silent and the tick
	 * pointer keeps moving, so switching back on does not replay a day. */
	if (!global_enabled()) {
		write_last_tick(now);
		return { ok: true, events: 0, skipped: 'global_off' };
	}

	let from = read_last_tick();

	if (from === null || from < now - MAX_TICK_MINUTES * 60)
		from = now - MAX_TICK_MINUTES * 60;

	const tz = timezone();
	const rules = enabled_timerules();
	const events = length(rules) ? events_in_range(rules, from, now, tz) : [];

	if (!length(events)) {
		write_last_tick(now);
		return { ok: true, events: 0, from, to: now };
	}

	const index = state_index();
	const arp = arp_table();
	const leases = lease_table();

	for (let e in events)
		apply_event(index, e.mac, e.target, 'timer', e.section, iso_at(tz, e.epoch), mac_to_ip(e.mac, arp, leases));

	/* Only advance the pointer once the events are on disk: re-running an
	 * applied event is idempotent, losing one to a failed commit is not. */
	if (!persist())
		return { ok: false, error: 'uci commit failed', events: length(events) };

	write_last_tick(now);

	return { ok: true, events: length(events), from, to: now };
}

/* Pure version of the convergence pass - the status page, the preview tab and
 * rebuild() all read the same plan. One entry per MAC: config timerstate is
 * written only through apply_event(), which keys on the address, but a hand
 * edited file can hold two rows for it, and pushing both would double the rules
 * while the drift check compares MAC sets and would never notice. */
function plan(enabled, states) {
	const blocks = [];
	const planned = {};
	const decisions = {};

	for (let s in states) {
		const mac = norm_mac(s.mac);

		if (mac === null || is_set(planned[mac]))
			continue;

		const source = s.source === 'manual' ? 'manual' : 'timer';
		const held = s.state === 'block';

		/* A manual decision is the operator's own words and survives the global
		 * switch; a clock decision does not. */
		const blocked = source === 'manual' ? held : (enabled && held);
		let ip = s.ip ?? null;

		if (ip === 'unknown')
			ip = null;

		planned[mac] = true;

		/* The same three-step answer preview_snapshot() gives, in the same order. */
		let reason = 'global_off';

		if (source === 'manual')
			reason = 'state_from_manual';
		else if (enabled)
			reason = 'state_from_timer';

		decisions[mac] = {
			blocked,
			source,
			state: held ? 'block' : 'allow',
			section: s.section ?? null,
			at: s.at ?? null,
			reason
		};

		if (blocked) {
			/* The comment has to name the rule an operator can find and edit, not
			 * the state row that happens to hold it. */
			const owner = is_set(s.section) && s.section !== '' ? s.section : s['.name'];

			push(blocks, { mac, ip, section: `${source}:${owner}`, rule_type: 'block' });
		}
	}

	return { blocks, decisions };
}

/* Converge the kernel chain onto the state machine. */
function rebuild() {
	load_cfg();

	if (!ensure_base())
		return { ok: false, error: 'nftables unavailable', blocks: [] };

	const wanted = plan(global_enabled(), sections('timerstate'));
	const current = chain_rules();

	/* The loop calls this every eval_interval seconds and the cron backstop on
	 * top of it. Rewriting a chain that already matched was the whole cost of
	 * that: about 2700 empty transactions a day, each one a delete-and-add pair
	 * per blocked device. An unchanged kernel state is now answered without
	 * touching netfilter, which also means the transaction below only ever
	 * carries a real change - so it is worth a log line every time. */
	if (same_fingerprint(kernel_fingerprint(current), plan_fingerprint(wanted.blocks)))
		return { ok: true, blocked: length(wanted.blocks), blocks: wanted.blocks, decisions: wanted.decisions };

	const before = {};

	for (let r in current)
		before[r.mac] = true;

	if (!nft_apply(batch_lines(wanted.blocks))) {
		log('err', 'atomic rebuild failed');
		return { ok: false, error: 'nft apply failed', blocks: wanted.blocks };
	}

	/* Established flows keep a freshly blocked device talking until conntrack
	 * forgets them, so tear them down as soon as the drop rules are in. */
	const fresh = filter(wanted.blocks, function (b) { return !is_set(before[b.mac]); });

	if (length(fresh)) {
		const arp = arp_table();
		const leases = lease_table();

		for (let b in fresh)
			clean_conntrack(b.ip ?? mac_to_ip(b.mac, arp, leases));
	}

	log('info', `reconciled: ${length(wanted.blocks)} device(s) blocked`);

	return { ok: true, blocked: length(wanted.blocks), blocks: wanted.blocks, decisions: wanted.decisions };
}

/* ── manual control ───────────────────────────────────── */

/* The row the manual control page lists. It records what the operator asked
 * for; the state machine, not this row, decides what the kernel does. */
function manual_row(mac) {
	for (let r in sections('rule'))
		if (norm_mac(r.mac) === mac)
			return r;

	return null;
}

function timed_macs() {
	const out = {};

	for (let r in enabled_timerules())
		out[norm_mac(r.device_mac)] = true;

	return out;
}

/* The enabled rules by the section name a state row records as its writer, holding
 * what each one still points at and which states it could have written. `timerstate
 * .section` says which rule last spoke for the device, so this answers the narrower
 * question - is that rule still configured to act on this device - and deleted,
 * disabled and re-aimed at another address all answer no. One pass over UCI and no
 * `date`, because the status page asks it every 15 seconds.
 *
 * The name cannot answer it alone. `config timerule` is written anonymously into
 * /etc/config/netcontrol, so ucode rehashes `cfgXXXXXX` from the position in the
 * file: deleting a rule renames every rule behind it, and the survivor inherits the
 * dead rule's name. On the name alone a delete would then read as if nothing was
 * lost. Matching the address and the writable states narrows that to the one case
 * where the name it inherited is also held by a rule of the same device that writes
 * the same state - a live rule that explains the state as well as the dead one did.
 *
 * A rule with an end moment writes both states: the start runs its own action, the
 * end runs the opposite one. */
function timerule_owners() {
	const out = {};

	for (let r in enabled_timerules())
		out[r['.name']] = {
			mac: norm_mac(r.device_mac),
			target: rule_target(r),
			both: is_set(r.time_end) && r.time_end !== '',
		};

	return out;
}

/* Whether the rule that wrote a state row still governs that device. A row not
 * written by a rule - the operator's own manual row, or the nameless open state -
 * has no owner that could have gone missing, and neither does a row with an empty
 * `section`, which is a hand edited or pre-recording leftover rather than a loss.
 *
 * This is a display fact only. Nothing is recomputed from it: a device that still
 * has another enabled rule keeps whatever state the vanished rule left, and the
 * engine moves it at the next moment of the surviving rules, never on the delete. */
function owner_alive(s, mac, owners) {
	if (`${s.source ?? 'none'}` !== 'timer')
		return true;

	const owner = `${s.section ?? ''}`;

	if (owner === '')
		return true;

	const who = norm_mac(mac);

	/* An address the config spells wrong has nothing to compare against, and an
	 * unanswerable question must not be reported as a deleted rule. */
	if (who === null)
		return true;

	const live = owners[owner];

	if (live === null || live.mac !== who)
		return false;

	return live.both || live.target === (`${s.state}` === 'block' ? 'block' : 'allow');
}

/* A device whose last enabled time rule was deleted, disabled or moved to
 * another address has no future event left to change its state, so whatever that
 * rule last wrote would stay in the kernel forever. Those devices are handed to
 * what is still configured: the manual row an operator left in place wins, and
 * with nothing left to govern the device at all it falls back to open.
 *
 * A device that still has an enabled rule is deliberately skipped - its next
 * moment belongs to the event stream, and a second evaluator here is how the
 * two answers drift apart. Rows whose source is already manual are the
 * operator's own words and stay untouched.
 *
 * Skipping is not forgetting. When the rule that wrote a state is gone but others
 * are left, the state holds until a survivor speaks, and status() reports that
 * row's owner as missing so the page can say which rule is no longer there. No
 * landing is computed for a delete: the engine moves a device by events.
 *
 * Reaching for manual_row() instead of current_time_target() is what keeps this
 * cheap enough to run on every save: no replay, no extra `date`. */
function reconcile_ruleless_states() {
	const index = state_index();
	const timed = timed_macs();
	const arp = arp_table();
	const leases = lease_table();
	const now = iso_now(timezone());
	const seen = {};
	let changed = 0;

	for (let s in sections('timerstate')) {
		const mac = norm_mac(s.mac);

		if (mac === null || s.source === 'manual' || is_set(seen[mac]) || is_set(timed[mac]))
			continue;

		seen[mac] = true;

		const row = manual_row(mac);
		const section = row === null ? null : row['.name'];
		const target = row === null ? 'allow' : (row.action === 'allow' ? 'allow' : 'block');
		const source = row === null ? 'none' : 'manual';

		if (`${s.state ?? 'allow'}` === target && `${s.source ?? 'none'}` === source)
			continue;

		if (!apply_event(index, mac, target, source, section, now, mac_to_ip(mac, arp, leases)))
			return { changed, error: 'cannot write state row' };

		changed++;
	}

	if (changed && !persist())
		return { changed, error: 'uci commit failed' };

	return { changed, error: null };
}

/* A device brought under manual control is also registered in the inventory so
 * the device list page shows it. The registration writes no kernel rule of its
 * own, and deleting the manual row later leaves it in place. */
function ensure_device(mac, label, ip) {
	const existing = first(sections('device'), function (d) { return norm_mac(d.mac) === mac; });

	if (existing !== null) {
		const stored = lc(`${existing.name ?? ''}`);

		/* The same policy sync_devices() applies: a row still carrying its own
		 * address counts as untitled, so the first real label is written, while
		 * a label the operator gave on the device page is left alone. */
		if (trim(`${label ?? ''}`) !== '' && (stored === '' || stored === mac))
			set_option(existing['.name'], 'name', label);

		if (is_set(ip) && trim(`${existing.ip ?? ''}`) === '')
			set_option(existing['.name'], 'ip', ip);

		return existing['.name'];
	}

	const section = uci.add(CFG, 'device');

	if (!is_set(section))
		return null;

	set_option(section, 'mac', mac);
	set_option(section, 'name', trim(`${label ?? ''}`) !== '' ? `${label}` : mac);

	if (is_set(ip))
		set_option(section, 'ip', ip);

	return section;
}

function device_index() {
	const out = {};

	for (let d in sections('device')) {
		const mac = norm_mac(d.mac);

		if (mac !== null)
			out[mac] = d['.name'];
	}

	return out;
}

/* The labels the operator typed on the device list, keyed by MAC. timerstate
 * rows carry no name - apply_event() writes state, not labels - so every view
 * that shows a device has to read the inventory for this to be a name at all.
 * A row whose name is still its own MAC counts as untitled. */
function device_names() {
	const out = {};

	for (let d in sections('device')) {
		const mac = norm_mac(d.mac);
		const name = trim(`${d.name ?? ''}`);

		if (mac !== null && name !== '' && lc(name) !== mac)
			out[mac] = name;
	}

	return out;
}

/* A time rule owns a device whether or not the inventory has heard of it yet,
 * so saving a rule registers the MAC and lets the rule name the device. The
 * stored address is canonicalised to lower case on the way, which is what both
 * nftables and every comparison here expect. */
function sync_devices() {
	const index = device_index();
	let dirty = false;

	for (let r in sections('timerule')) {
		const raw = `${r.device_mac ?? ''}`;
		const mac = norm_mac(raw);

		if (mac === null)
			continue;

		if (raw !== mac) {
			set_option(r['.name'], 'device_mac', mac);
			dirty = true;
		}

		const label = trim(`${r.device_name ?? ''}`);

		if (!is_set(index[mac])) {
			const section = uci.add(CFG, 'device');

			if (!is_set(section))
				continue;

			set_option(section, 'mac', mac);
			set_option(section, 'name', label !== '' ? label : mac);
			index[mac] = section;
			dirty = true;
		}

		/* The rule names a device the first time the inventory hears of it; after
		 * that the device list owns the label. Overwriting unconditionally would
		 * mean a rename made on the device page silently reverted the next time
		 * any rule of that device was saved. */
		const stored_name = lc(`${uci.get(CFG, index[mac], 'name') ?? ''}`);

		if (label !== '' && (stored_name === '' || stored_name === mac)) {
			set_option(index[mac], 'name', label);
			dirty = true;
		}
	}

	if (dirty && !persist())
		return false;

	return true;
}

/* One time clean up of what earlier engines needed. `rule_mode`, `override` and
 * `device_enabled` had no meaning once a rule carried its own target;
 * `rule_type`, `source` and `enabled` on a `rule` section were write-only
 * bookkeeping that the plan never read, so they are swept too. */
function migrate_legacy() {
	let dirty = false;

	for (let r in sections('timerule')) {
		for (let k in ['rule_mode', 'override', 'device_enabled']) {
			if (uci.get(CFG, r['.name'], k) === null)
				continue;

			uci.delete(CFG, r['.name'], k);
			dirty = true;
		}

		if (uci.get(CFG, r['.name'], 'action') === null) {
			set_option(r['.name'], 'action', 'block');
			dirty = true;
		}
	}

	for (let r in sections('rule')) {
		for (let k in ['override', 'rule_type', 'source', 'enabled']) {
			if (uci.get(CFG, r['.name'], k) === null)
				continue;

			uci.delete(CFG, r['.name'], k);
			dirty = true;
		}
	}

	if (dirty && !persist())
		return false;

	return true;
}

function manual_set(target, action, name) {
	if (target === null)
		return { ok: false, error: 'invalid mac address' };

	const wanted = action === 'allow' ? 'allow' : 'block';

	load_cfg();

	const arp = arp_table();
	const leases = lease_table();
	const ip = mac_to_ip(target, arp, leases);
	const row = manual_row(target);
	const section = row?.['.name'] ?? uci.add(CFG, 'rule');

	if (!is_set(section))
		return { ok: false, error: 'cannot create rule section' };

	const host = first(leases, function (l) { return l.mac === target; });

	/* One timestamp per call: `date` is a fork and every field below shares it,
	 * so the row and its event agree on a single moment. */
	const now = iso_now(timezone());

	/* Re-adding a device that already has a row keeps its label unless the
	 * caller supplies a new one. */
	const label = trim(`${name ?? ''}`) !== '' ? `${name}`
		: (row?.name ?? host?.hostname ?? target);

	set_option(section, 'mac', target);
	set_option(section, 'name', label);
	set_option(section, 'ip', ip ?? 'unknown');
	set_option(section, 'action', wanted);
	set_option(section, 'updated_at', now);

	if (uci.get(CFG, section, 'created_at') === null)
		set_option(section, 'created_at', now);

	ensure_device(target, label, ip);

	const index = state_index();

	apply_event(index, target, wanted, 'manual', section, now, ip);

	if (!persist())
		return { ok: false, error: 'uci commit failed' };

	const res = rebuild();

	if (!res.ok)
		return res;

	const blocked = any(res.blocks, function (b) { return b.mac === target; });

	log('info', `manual ${wanted} ${target} (${length(res.blocks)} device(s) blocked)`);

	return { ok: true, mac: target, action: wanted, section, ip, blocked, devices: res.blocked };
}

/* Withdrawing the row is itself an event, and its target is what the clock says
 * for this device right now - allow when no enabled rule covers the moment.
 * Deleting it never touches the time rules or the inventory. */
function manual_delete(target) {
	const mac = norm_mac(target);

	if (mac === null && !is_section_id(target))
		return { ok: false, error: 'not a mac address or section id' };

	load_cfg();

	const rows = sections('rule');
	const removed = [];
	let address = mac;

	for (let r in rows) {
		if (mac !== null ? norm_mac(r.mac) !== mac : r['.name'] !== target)
			continue;

		if (address === null)
			address = norm_mac(r.mac);

		uci.delete(CFG, r['.name']);
		push(removed, r['.name']);
	}

	if (!length(removed) || address === null)
		return { ok: false, error: 'this device is not under manual control' };

	const restore = current_time_target(address);
	const arp = arp_table();
	const leases = lease_table();
	const index = state_index();

	apply_event(index, address, restore.target, restore.source === 'none' ? 'none' : 'timer',
		restore.section, iso_now(timezone()), mac_to_ip(address, arp, leases));

	if (!persist())
		return { ok: false, error: 'uci commit failed' };

	const res = rebuild();

	if (!res.ok)
		return res;

	log('info', `deleted ${length(removed)} manual row(s) for ${address}, state back to ${restore.target}`);

	return { ok: true, mac: address, removed: length(removed), state: restore.target, devices: res.blocked };
}

/* ── cron ─────────────────────────────────────────────── */

function watchdog_setting() {
	return clamp_int(get_global('watchdog_interval', DEFAULT_WATCHDOG_INTERVAL),
		DEFAULT_WATCHDOG_INTERVAL, MIN_WATCHDOG_INTERVAL, MAX_WATCHDOG_INTERVAL);
}

/* The plugin owns exactly two tagged lines: the time rule backstop tick and the
 * watchdog reconcile. The evaluation loop is the driver of time rules and runs
 * at eval_interval; these two only matter when that loop is gone, which is why
 * the tick here is coarse - BusyBox crond logs a syslog line for every job it
 * spawns, and a per minute tick from this package used to be a third of the
 * whole visible log ring. */
function sync_cron() {
	load_cfg();

	const existing = readfile(CRON_FILE);
	const lines = [];

	if (is_set(existing)) {
		const kept = split(existing, '\n');
		const last = length(kept) - 1;

		/* A trailing newline shows up as one empty element and the file is
		 * rewritten with a single terminator; every other blank line belongs to
		 * the user and survives. */
		for (let i = 0; i <= last; i++) {
			if (i === last && kept[i] === '')
				continue;

			if (index(kept[i], CRON_TAG) >= 0)
				continue;

			push(lines, kept[i]);
		}
	}

	push(lines, `*/${CRON_BACKSTOP_MINUTES} * * * * ${UBUS_TIMERULES} '{}' ${CRON_TAG}timerules`);
	push(lines, `*/${watchdog_setting()} * * * * ${UBUS_WATCHDOG} '{}' ${CRON_TAG}watchdog`);

	const body = `${strjoin(lines, '\n')}\n`;

	/* apply() runs on every save, and a reload restarts the cron job queue, so
	 * an unchanged file is left alone rather than rewritten and reloaded. */
	if (existing === body)
		return true;

	if (writefile(CRON_TMP, body) === null) {
		log('err', 'failed to write crontab');
		return false;
	}

	if (run(`chmod 600 ${shellquote(CRON_TMP)} && mv ${shellquote(CRON_TMP)} ${shellquote(CRON_FILE)}`).rc !== 0) {
		log('err', 'failed to install crontab');
		return false;
	}

	init_action('cron', 'reload');

	return true;
}

/* ── eval loop ────────────────────────────────────────── */

function eval_interval() {
	return clamp_int(get_global('eval_interval', DEFAULT_EVAL_INTERVAL),
		DEFAULT_EVAL_INTERVAL, MIN_EVAL_INTERVAL, MAX_EVAL_INTERVAL);
}

function daemon_pid() {
	const raw = trim(`${readfile(DAEMON_PID) ?? ''}`);

	if (match(raw, /^[0-9]+$/) === null)
		return null;

	const pid = raw * 1;

	return run(`kill -0 ${pid} 2>/dev/null`).rc === 0 ? pid : null;
}

function stop_daemon() {
	const pid = daemon_pid();

	if (pid !== null) {
		/* The loop is a session leader created by setsid, so a negative id
		 * reaches the `sleep` child too and nothing is orphaned. TERM first:
		 * the loop spends up to eval_interval seconds inside sleep, so a
		 * graceful kill can linger long enough that start() would still see
		 * the old PID alive and refuse to launch a new one. */
		run(`kill -TERM -${pid} 2>/dev/null`);

		for (let i = 0; i < 3; i++) {
			if (run(`kill -0 ${pid} 2>/dev/null`).rc !== 0)
				break;

			run('sleep 1');
		}

		if (run(`kill -0 ${pid} 2>/dev/null`).rc === 0)
			run(`kill -KILL -${pid} 2>/dev/null`);
	}

	run(`rm -f ${shellquote(DAEMON_PID)} ${shellquote(DAEMON_TICK)}`);

	return { ok: true, running: daemon_pid() !== null };
}

function start_daemon() {
	load_cfg();

	const interval = eval_interval();

	if (daemon_pid() !== null) {
		if (trim(`${readfile(DAEMON_TICK) ?? ''}`) === `${interval}`)
			return { ok: true, running: true, interval };

		stop_daemon();
	}

	run('mkdir -p /tmp/run >/dev/null 2>&1');

	if (writefile(DAEMON_TICK, `${interval}\n`) === null)
		return { ok: false, error: 'cannot write tick file' };

	/* setsid + background: the loop has to outlive this ubus call, and its
	 * interval is recorded so apply() knows when to restart it.
	 *
	 * $! is the loop's own PID, not setsid's: setsid only forks when the caller
	 * is already a process group leader, and a job backgrounded from a popen
	 * shell is not one. Measured on the target (BusyBox 1.37): the outer $! and
	 * the inner $$ are the same number, so the file names the process that is
	 * still running after setsid execs. */
	const loop = `while sleep ${interval}; do ${UBUS_TIMERULES} >/dev/null 2>&1; done`;

	run(`setsid ash -c ${shellquote(loop)} >/dev/null 2>&1 & echo $! > ${shellquote(DAEMON_PID)}`);

	return { ok: true, running: daemon_pid() !== null, interval };
}

/* ── discovery ────────────────────────────────────────── */

function discover() {
	load_cfg();

	const leases = {};
	const order = [];
	const states = {};
	const arp = arp_table();
	const online = online_map(arp);
	const names = device_names();
	const neigh_re = regexp(`^([0-9.]+) dev ([^[:space:]]+).*lladdr (${MAC_OCTETS})`);

	/* First row wins: the same tie break plan() and managed() use, so a hand
	 * edited file cannot make one view disagree with another. */
	for (let s in sections('timerstate')) {
		const mac = norm_mac(s.mac);

		if (mac !== null && !is_set(states[mac]))
			states[mac] = s;
	}

	for (let l in lease_table()) {
		if (!is_set(leases[l.mac])) {
			leases[l.mac] = l;
			push(order, l.mac);
		}
	}

	for (let line in split(run('ip -4 neigh show 2>/dev/null').out, '\n')) {
		const m = match(lc(line), neigh_re);

		if (!m)
			continue;

		const mac = norm_mac(m[3]);

		if (mac === null || is_set(leases[mac]))
			continue;

		leases[mac] = { mac, ip: m[1], hostname: null };
		push(order, mac);
	}

	for (let mac in sort(keys(states)))
		if (!is_set(leases[mac])) {
			leases[mac] = { mac, ip: null, hostname: null };
			push(order, mac);
		}

	const devices = [];

	/* Identity and reachability only: the device list page is the inventory, and
	 * the pages that answer "is this device blocked" are the ones the engine
	 * drives. Fields added here and read by no view are how a stale answer gets
	 * to look official. */
	for (let mac in order) {
		const st = states[mac];
		const lease = leases[mac]?.hostname ?? null;

		push(devices, {
			mac,
			ip: leases[mac]?.ip ?? st?.ip ?? null,
			hostname: lease,
			online: is_set(online[mac]),
			name: names[mac] ?? lease ?? null
		});
	}

	return devices;
}

/* ── manual control surface ───────────────────────────── */

/* One row per MAC a manual row owns: the action the operator chose beside what
 * the state machine and the kernel really hold for that device. */
function managed() {
	load_cfg();

	const by_rule = group_by(sections('rule'), 'mac');
	const states = group_by(sections('timerstate'), 'mac');
	const timed = timed_macs();
	const arp = arp_table();
	const leases = {};
	const online = online_map(arp);
	const held = kernel_holds();
	const names = device_names();
	const out = [];

	for (let l in lease_table())
		leases[l.mac] = l;

	for (let mac in sort(keys(by_rule))) {
		const rows = by_rule[mac];
		const named = first(rows, function (r) { return is_set(r.name) && trim(`${r.name}`) !== ''; });
		const row = rows[0];
		const st_rows = states[mac] ?? [];
		const st = length(st_rows) ? st_rows[0] : null;
		const stored = row.ip === 'unknown' ? null : row.ip;
		const lease = leases[mac]?.hostname ?? null;

		push(out, {
			mac,
			ip: leases[mac]?.ip ?? stored ?? mac_to_ip(mac, arp, []),
			name: names[mac] ?? named?.name ?? lease ?? null,
			online: is_set(online[mac]),
			blocked: is_set(held[mac]),
			action: row.action ?? 'block',
			section: row['.name'],
			state: st?.state ?? null,
			source: st?.source ?? null,
			event_at: st?.at ?? null,
			timed: is_set(timed[mac]),
			created_at: row.created_at ?? null,
			updated_at: row.updated_at ?? null
		});
	}

	return {
		devices: out,
		enabled: global_enabled(),
		local_time: iso_now(timezone()),
		timezone: timezone_value()
	};
}

/* ── status ───────────────────────────────────────────── */

function status() {
	load_cfg();

	const ctx = clock_context();
	const enabled = global_enabled();
	const states = sections('timerstate');
	const manual_rows = group_by(sections('rule'), 'mac');
	const wanted = plan(enabled, states);
	const owners = timerule_owners();
	/* Two forks describe the kernel here, and that is the floor: one listing
	 * answers both "how many drop rules" and "which addresses", one table probe
	 * answers both existence flags. The status page polls this every 15 s, so
	 * every extra `nft` was a fork the router paid 5760 times a day. */
	const rules = chain_rules();
	const present = kernel_presence();
	const actual = macs_in(rules);
	const blocks = wanted.blocks;
	const leases = lease_table();
	const arp = arp_table();
	const online = online_map(arp);
	const names = device_names();

	return {
		enabled,
		timezone: timezone_value(),
		timezone_valid: is_timezone(timezone_value()),
		watchdog_interval: watchdog_setting(),
		eval_interval: eval_interval(),
		offload_detected: get_global('offload_detected', '0') === '1',
		clock_ok: clock_ok(),
		nft_available: nft_available(),
		table_exists: present.table,
		chain_exists: present.chain,
		local_time: iso_now(ctx.tz),
		utc_time: trim(run('date -u "+%Y-%m-%dT%H:%M:%SZ" 2>/dev/null').out),
		daemon_running: daemon_pid() !== null,
		timerule_count: length(sections('timerule')),
		state_count: length(states),
		drop_rules: length(rules),
		kernel_macs: actual,
		expected_macs: sort(map(blocks, function (b) { return b.mac; })),
		consistent: same_fingerprint(kernel_fingerprint(rules), plan_fingerprint(blocks)),
		devices: map(states, function (s) {
			const mac = norm_mac(s.mac);
			const row = first(manual_rows[mac] ?? [], function (r) { return true; });

			return {
				section: s['.name'],
				mac,
				name: names[mac] ?? row?.name ?? mac,
				/* Kept as written, folds included nothing into: a device handed back to
				 * open by reconcile_ruleless_states() carries `none`, and calling that
				 * "time rule" here would put a rule on the screen in the same breath as
				 * the timerule count one row above says zero. */
				source: s.source === 'manual' ? 'manual' : (s.source === 'none' ? 'none' : 'timer'),
				owner_alive: owner_alive(s, mac, owners),
				state: s.state === 'block' ? 'block' : 'allow',
				rule_section: s.section ?? null,
				at: s.at ?? null,
				ip: (s.ip && s.ip !== 'unknown') ? s.ip : mac_to_ip(mac, arp, leases),
				online: is_set(online[mac]),
				blocked: wanted.decisions[mac]?.blocked === true,
				created_at: row?.created_at ?? null
			};
		})
	};
}

/* ── watchdog ─────────────────────────────────────────── */

function detect_offload() {
	/* A separate cursor: loading another package into the netcontrol cursor
	 * would drop any delta it is still holding. */
	const fw = cursor();

	if (fw.load('firewall')) {
		if (to_int(fw.get('firewall', 'defaults', 'flow_offloading'), 0) === 1)
			return true;

		return to_int(fw.get('firewall', 'defaults', 'flow_offloading_hw'), 0) === 1;
	}

	/* No firewall UCI to read: fall back to the kernel, where an offload
	 * flowtable only exists if fw4 was told to create one. A loaded
	 * nf_flow_table module is not evidence - it is built as a module on most
	 * targets even when offloading stays disabled. */
	return match(run(`${NFT_BIN} list flowtables inet 2>/dev/null`).out, /flowtable [A-Za-z0-9_-]+ \{/) !== null;
}

function watchdog() {
	load_cfg();

	const detected = detect_offload();
	const tz_ok = is_timezone(timezone_value());
	const snap = status();
	const want_offload = detected ? '1' : '0';
	let dirty = false;

	/* Only the offload flag is worth a place in the configuration: it needs no
	 * probe to display, and the status poll would otherwise run the cursor read
	 * above on every refresh. Timezone validity is cheap to test, so status()
	 * does that live instead of caching a copy that can go stale.
	 *
	 * uci.set stages into the very context uci.get reads, so the commit
	 * decision has to be taken from the pre-write comparison: re-reading the
	 * option below would hide the change and leave an absent->present flip
	 * uncommitted, keeping the stale warning on screen forever. */
	if (get_global('offload_detected', '0') !== want_offload) {
		set_option('global', 'offload_detected', want_offload);
		dirty = true;
	}

	if (dirty)
		persist();

	if (!tz_ok)
		log('warn', 'timezone data missing, install zoneinfo-asia');

	/* The evaluation loop is what enforces time rules at eval_interval; the cron
	 * tick is only a backstop every few minutes. A loop that died - killed
	 * during an upgrade, or never started after a boot where the clock was still
	 * unsynced - has to be brought back here, before the consistency short
	 * circuit, otherwise an on-kernel-chain match would leave the timerule
	 * enforcement sleeping on the backstop forever. start_daemon() is a no-op
	 * while the recorded PID is alive, so this is safe to attempt every round. */
	if (!snap.daemon_running) {
		log('warn', 'evaluation loop not running, restarting it');
		start_daemon();
	}

	if (!clock_ok()) {
		log('warn', 'system clock not synchronised, skipping reconcile');
		return { ok: true, consistent: snap.consistent, skipped: 'clock', offload: detected };
	}

	if (snap.consistent)
		return { ok: true, consistent: true, offload: detected };

	/* The rule counts are part of the line because a fingerprint can differ while
	 * both address lists read the same: one of a device's two directions deleted,
	 * or a block that changed owner. */
	log('warn', `state drift detected: kernel ${strjoin(snap.kernel_macs, ' ')}` +
		` (${snap.drop_rules} rule(s)) vs plan ${strjoin(snap.expected_macs, ' ')}` +
		` (${length(snap.expected_macs) * 2} rule(s))`);

	const res = rebuild();

	return { ok: res.ok, consistent: res.ok, offload: detected, rebuilt: res.blocked };
}

/* ── preview ──────────────────────────────────────────── */

/* The day frame the preview has to walk, decided by the longest cycle in scope.
 * Only a monthly rule can be more than a week out - day 31 to February to March
 * is 59 days - and day_range() pays one `date` fork per day, so the wide frame
 * is bought only when a monthly rule is actually present. */
function preview_frame_days(rules) {
	for (let r in rules) {
		if ((r.cycle_type ?? 'daily') === 'monthly')
			return NEXT_EVENT_DAYS;
	}

	return SHORT_EVENT_DAYS;
}

/* What the state machine holds for each device, and the next moment each of
 * its rules will act. Nothing here recomputes a window: the answer is the
 * recorded state, and the future is the event stream. */
function preview_snapshot(wanted) {
	load_cfg();

	const ctx = clock_context();
	const enabled = global_enabled();
	const states = sections('timerstate');
	const by_state = group_by(states, 'mac');
	const timerules = sections('timerule');
	const by_time = group_by(timerules, 'device_mac');
	const by_rule = group_by(sections('rule'), 'mac');
	const planned = plan(enabled, states);
	const owners = timerule_owners();
	const out = [];

	/* One day frame for the whole reply: every rule then scans cached midnights
	 * instead of spawning its own `date` per day. */
	const horizon = preview_frame_days(wanted === null ? timerules : (by_time[wanted] ?? []));
	const frame = day_range(ctx.tz, ctx.epoch, ctx.epoch + horizon * 86400, horizon + 1);

	for (let mac in sort(keys(merge(merge(by_state, by_time), by_rule)))) {
		if (wanted !== null && mac !== wanted)
			continue;

		const rows = by_state[mac] ?? [];
		const st = length(rows) ? rows[0] : null;
		const source = st?.source ?? null;

		/* Why the state is what it is, in the three steps the operator can check:
		 * no row at all, a manual row, or a clock owned device. */
		let reason = 'global_off';

		if (st === null)
			reason = 'unmanaged';
		else if (source === 'manual')
			reason = 'state_from_manual';
		else if (enabled)
			reason = 'state_from_timer';

		push(out, {
			mac,
			/* The plan, not the kernel: this panel answers "what will these rules
			 * do", and reading the chain here would make it disagree with the
			 * status page the moment the two drift apart. */
			blocked: planned.decisions[mac]?.blocked === true,
			state: st?.state ?? 'allow',
			source,
			owner_alive: st === null ? true : owner_alive(st, mac, owners),
			section: st?.section ?? null,
			at: st?.at ?? null,
			reason,
			rules: map(by_time[mac] ?? [], function (r) {
				const w = rule_window(r);
				const live = is_bool(r.enabled, true) && enabled;
				const next = w.valid && live ? rule_next_event(r, ctx.tz, ctx.epoch, frame) : null;

				return {
					section: r['.name'],
					name: r.name ?? r['.name'],
					action: rule_target(r),
					cycle_type: r.cycle_type ?? 'daily',
					all_day: is_bool(r.all_day, false),
					start: r.time_start ?? null,
					end: r.time_end ?? null,
					enabled: is_bool(r.enabled, true),
					valid: w.valid,
					next: nextEventFrame(next)
				};
			})
		});
	}

	return { devices: out, local_time: iso_now(ctx.tz), timezone: timezone_value() };
}

/* ── public API ───────────────────────────────────────── */

const methods = {
	/* Capability probe the views use to hide unavailable sections. */
	stat: {
		call: function () {
			return {
				nftables: nft_available(),
				conntrack: has(CT_BIN, "x"),
				leases: has(LEASES, "r"),
				cron: has(CRON_FILE, "r")
			};
		}
	},

	status: {
		call: function () {
			return status();
		}
	},

	devices: {
		call: function () {
			return { devices: discover() };
		}
	},

	/* Single hook the views call after form.Map has committed UCI. */
	apply: {
		call: function () {
			load_cfg();

			/* Both cleanups commit by themselves, so a failed write has to stop the
			 * call: continuing would converge the kernel onto a state that never
			 * reached the flash and report success while it did. */
			if (!migrate_legacy() || !sync_devices())
				return { result: { ok: false, error: 'uci commit failed', blocked: 0 } };

			const cron = sync_cron();
			const daemon = start_daemon();
			const sync = reconcile_ruleless_states();

			/* Stopping here matters as much as for the commits above: a state the
			 * flash never got would still be converged into the kernel and reported
			 * as saved. */
			if (sync.error !== null)
				return { result: { ok: false, error: sync.error, blocked: 0 } };

			const res = rebuild();

			return { result: { ok: res.ok && cron, cron, daemon, blocked: res.blocked, error: res.error } };
		}
	},

	/* Rows for the manual control page: one per rule section the operator owns. */
	managed: {
		call: function () {
			return managed();
		}
	},

	manualSet: {
		args: { mac: 'string', action: 'string', name: 'string' },
		call: function (request) {
			const a = request.args ?? {};

			return { result: manual_set(norm_mac(a.mac), a.action, a.name) };
		}
	},

	manualDelete: {
		args: { mac: 'string' },
		call: function (request) {
			return { result: manual_delete(`${(request.args ?? {}).mac ?? ''}`) };
		}
	},

	preview: {
		args: { mac: 'string' },
		call: function (request) {
			return { result: preview_snapshot(norm_mac((request.args ?? {}).mac)) };
		}
	},

	/* The evaluation tick: run every event due since the last call, then
	 * converge the chain onto the state machine. */
	timerules: {
		call: function () {
			const t = tick();

			if (!clock_ok())
				return { result: { ok: true, skipped: 'clock', events: 0, blocked: 0 } };

			const res = rebuild();

			return { result: merge(t, { blocked: res.blocked, ok: t.ok && res.ok }) };
		}
	},

	watchdog: {
		call: function () {
			return { result: watchdog() };
		}
	},

	boot: {
		call: function () {
			if (!ensure_base())
				return { result: { ok: false, error: 'nftables unavailable' } };

			/* A cold start leaves /tmp behind, so the tick pointer is gone and the
			 * first tick replays the last day - the same thing a loop that died
			 * mid-outage gets. Seeding the pointer with the boot time instead would
			 * strand an unblock that fell due while the router was off: the device
			 * stays blocked until the rule fires again, which for a daily rule means
			 * the whole next day. */
			load_cfg();
			migrate_legacy();
			sync_devices();

			/* Rows stranded by an older build - a rule deleted while its block was
			 * still held - are collected here rather than waiting for a save. */
			reconcile_ruleless_states();

			const res = rebuild();

			sync_cron();
			start_daemon();

			return { result: { ok: res.ok, blocked: res.blocked, error: res.error } };
		}
	},

	startDaemon: {
		call: function () {
			return { result: start_daemon() };
		}
	},

	stopDaemon: {
		call: function () {
			return { result: stop_daemon() };
		}
	},

	/* JSON dump of everything the UI edits; the view turns it into a download. */
	backup: {
		call: function () {
			load_cfg();

			return {
				generated: iso_now(timezone()),
				global: {
					enabled: get_global('enabled', '1'),
					timezone: get_global('timezone', DEFAULT_TIMEZONE),
					eval_interval: get_global('eval_interval', `${DEFAULT_EVAL_INTERVAL}`),
					watchdog_interval: get_global('watchdog_interval', `${DEFAULT_WATCHDOG_INTERVAL}`)
				},
				rules: sections('rule'),
				devices: sections('device'),
				timerules: sections('timerule'),
				states: sections('timerstate')
			};
		}
	}
};

return { 'luci.netcontrol': methods };