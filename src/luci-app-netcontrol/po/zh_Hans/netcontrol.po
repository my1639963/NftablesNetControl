#
msgid ""
msgstr ""
"Project-Id-Version: luci-app-netcontrol 1.3.0\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "%s device(s) under manual control"
msgstr "手动管控设备：%s 台"

msgid "%s, once"
msgstr "%s 单次"

msgid "A rule owns its start moment and, if one is given, its end moment: at "
"the start it applies its own action, at the end the opposite one. Rules "
"are never compared with each other, so overlapping windows flip back and "
"forth exactly as configured."
msgstr "规则拥有自己的开始时刻，若填写了结束时刻则再拥有第二个时刻：开始时刻执行本规则选定的动作，结束时刻执行相反动作。规则之间从不相互比较，因此时间窗交叠时会严格按配置反复切换。"

msgid "A time rule owns this device: the next scheduled event replaces this result."
msgstr "该设备由时间规则掌控：下一次计划事件会覆盖这个结果。"

msgid "A timezone name is required, e.g. Asia/Shanghai."
msgstr "必须填写时区名称，例如 Asia/Shanghai。"

msgid "Access Control"
msgstr "上网控制"

msgid "Action"
msgstr "操作"

msgid "Add"
msgstr "添加"

msgid "Add a device to control manually"
msgstr "添加手动管控设备"

msgid "Added"
msgstr "已添加"

msgid "Adding the device failed: %s"
msgstr "添加设备失败：%s"

msgid "all day"
msgstr "全天"

msgid "All day"
msgstr "全天"

msgid "Allow"
msgstr "放行"

msgid "Allow this device"
msgstr "放行该设备"

msgid "Applying the rules failed: %s"
msgstr "下发规则失败：%s"

msgid "Block"
msgstr "阻断"

msgid "Block disconnects the device at once, Allow brings it back. Either way the next scheduled event of this device replaces the result."
msgstr "阻断会立即断开该设备上网，放行会把它恢复。无论哪一种，该设备的下一次计划事件都会覆盖这个结果。"

msgid "Block this device"
msgstr "阻断该设备"

msgid "blocked"
msgstr "阻断"

msgid "Blocked in kernel / expected"
msgstr "内核已阻断 / 预期数量"

msgid "Cancel"
msgstr "取消"

msgid "consistent"
msgstr "一致"

msgid "Cycle"
msgstr "周期"

msgid "Daily"
msgstr "每天"

msgid "Day %d"
msgstr "%d 日"

msgid "Day values"
msgstr "日期取值"

msgid "Delete"
msgstr "删除"

msgid "Device Control"
msgstr "设备管控"

msgid "Device list"
msgstr "设备清单"

msgid "Device MAC"
msgstr "设备 MAC"

msgid "Device name"
msgstr "设备名称"

msgid "Device states"
msgstr "设备状态"

msgid "Device states held"
msgstr "引擎持有的设备状态"

msgid "Devices seen in the DHCP leases and the neighbour table. Adding one records it in the configuration only, without touching the kernel rule set."
msgstr "来自 DHCP 租约与邻居表的设备。添加只会把设备记录到配置里，不会改动内核规则。"

msgid "Discovered devices"
msgstr "发现的设备"

msgid "Download the current configuration as JSON"
msgstr "将当前配置导出为 JSON"

msgid "drifted"
msgstr "已漂移"

msgid "Drop rules in chain"
msgstr "链中的 drop 规则"

msgid "Each entry is one extra execution outside the clock: it applies "
"immediately and lasts until the next scheduled event of that device. "
"Deleting one hands the device back to its time rules right away, and a "
"device no time rule governs stays open."
msgstr "这里的每一条都是时钟之外的一次额外执行：添加后立即生效，并持续到该设备的下一次计划事件。删除一条会马上把设备交还给时间规则；没有任何时间规则约束的设备保持放开。"

msgid "Edit device"
msgstr "编辑设备"

msgid "Edit time rule"
msgstr "编辑时间规则"

msgid "End time"
msgstr "结束时间"

msgid "ends"
msgstr "结束"

msgid "Enforcement"
msgstr "规则执行情况"

msgid "Enter a valid MAC address."
msgstr "请输入正确的 MAC 地址。"

msgid "ERROR"
msgstr "错误"

msgid "Evaluated at %s"
msgstr "评估时间：%s"

msgid "Evaluation loop"
msgstr "评估循环"

msgid "Evaluation loop wake-up (seconds)"
msgstr "评估循环唤醒周期（秒）"

msgid "Export backup"
msgstr "导出备份"

msgid "Fri"
msgstr "周五"

msgid "Give a start time, or tick All day."
msgstr "请填写开始时间，或勾选全天。"

msgid "Global control switch"
msgstr "全局管控开关"

msgid "Global settings"
msgstr "全局设置"

msgid "Global switch"
msgstr "全局开关"

msgid "Hardware flow offloading is active: established flows may keep passing after a device is blocked."
msgstr "硬件流量卸载已启用：设备被阻断后，已建立的连接可能仍然放行。"

msgid "HH:MM, 24 hour clock."
msgstr "HH:MM，24 小时制。"

msgid "How often the background loop wakes up. Rule moments are matched to the "
"minute, so this only decides how soon after a minute boundary an event "
"is applied. Cron is a backstop every 5 minutes for the case where this "
"loop is gone, and the range stops at that backstop so the loop stays the "
"driver. Range 60-300, default 60."
msgstr "后台循环多久唤醒一次。规则时刻按分钟对齐，所以这里只决定事件在整分后多久被应用；cron 每 5 分钟兜底一次，只在循环失联时接管；上限就停在兜底间隔，好让驱动的一直是这个循环。范围 60-300，默认 60。"

msgid "How often the watchdog compares the kernel rules with the expected set, reconciles drift and restarts the evaluation loop when it is gone. Range 1-30, default 3."
msgstr "看门狗比对内核规则与应有集合并修复偏差、并在评估循环失联时重新启动它的频率。范围 1-30，默认 3。"

msgid "IANA timezone name used to evaluate every time rule, e.g. Asia/Shanghai. The zoneinfo-asia package must be installed for it to resolve."
msgstr "评估所有时间规则使用的 IANA 时区名称，例如 Asia/Shanghai。需安装 zoneinfo-asia 软件包才能解析。"

msgid "In kernel"
msgstr "内核中生效"

msgid "INFO"
msgstr "提示"

msgid "Invalid timezone format. Use an IANA name such as Asia/Shanghai."
msgstr "时区格式无效。请使用 IANA 名称，例如 Asia/Shanghai。"

msgid "invalid window"
msgstr "时间窗无效"

msgid "IP"
msgstr "IP"

msgid "Kernel rules drifted from the expected set. Reconcile to converge them."
msgstr "内核规则与预期集合不一致。请点击“立即核对”使其收敛。"

msgid "Last event"
msgstr "最近事件"

msgid "Local time (%s)"
msgstr "本地时间（%s）"

msgid "Local time: %s"
msgstr "本地时间：%s"

msgid "manual"
msgstr "手动"

msgid "Manual Control"
msgstr "手动管控"

msgid "Mon"
msgstr "周一"

msgid "Monthly"
msgstr "每月"

msgid "Names the device when the inventory has not heard of it yet. A device that already has a label keeps the one from the device list, so rename it there."
msgstr "设备清单还不认识这台设备时，由这里为它命名。已经有标签的设备会保留设备清单里的名字，要改名请到设备清单里修改。"

msgid "next"
msgstr "下次"

msgid "nftables rejected the rule set."
msgstr "nftables 拒绝了规则集。"

msgid "No"
msgstr "否"

msgid "No device has been seen yet."
msgstr "还没有发现任何设备。"

msgid "No device is governed by a time rule yet."
msgstr "还没有设备被时间规则管控。"

msgid "No device is under manual control. Use Add above to block or release one."
msgstr "当前没有手动管控的设备。点击上方“添加”来限制或放行设备。"

msgid "offline"
msgstr "离线"

msgid "once"
msgstr "单次"

msgid "online"
msgstr "在线"

msgid "Online state"
msgstr "在线状态"

msgid "open"
msgstr "放行"

msgid "Optional"
msgstr "选填"

msgid "Optional reference; the live address comes from the leases."
msgstr "仅作参考，实际地址以 DHCP 租约为准。"

msgid "Optional, used for display only."
msgstr "可选，仅用于显示。"

msgid "Optional. HH:MM, earlier than the start time puts the moment on the next day. Left empty the rule is a single moment: it runs its action once per cycle and then does nothing further."
msgstr "可选。HH:MM。早于开始时间表示该时刻落在次日。留空则本规则只有一个时刻：每个周期执行一次选定动作，之后不再动作。"

msgid "Pick a known device, or type the address of one that is currently off."
msgstr "选择已知设备，或手动输入一台当前已断电设备的地址。"

msgid "Reconcile failed"
msgstr "核对失败"

msgid "Reconcile now"
msgstr "立即核对"

msgid "Rule enabled"
msgstr "规则已启用"

msgid "Rule name"
msgstr "规则名称"

msgid "Rules"
msgstr "规则"

msgid "running"
msgstr "运行中"

msgid "Sat"
msgstr "周六"

msgid "Save"
msgstr "保存"

msgid "Source"
msgstr "来源"

msgid "Start time"
msgstr "开始时间"

msgid "starts"
msgstr "开始"

msgid "Starts at midnight, ends at the next midnight."
msgstr "从零时起作用，到下一个零时结束。"

msgid "State"
msgstr "状态"

msgid "State and upcoming events"
msgstr "状态与即将到来的事件"

msgid "Status Overview"
msgstr "状态总览"

msgid "Stop controlling this device"
msgstr "删除该设备的管控条目"

msgid "stopped"
msgstr "已停止"

msgid "Sun"
msgstr "周日"

msgid "Switching the global control off lifts every time based rule but keeps manual blocks, which is the safe state for maintenance windows."
msgstr "关闭全局管控会解除所有基于时间的规则，但保留手动阻断，这是维护窗口期的安全状态。"

msgid "The configured timezone has no zoneinfo data on this device, so the rules fall back to the system clock zone. Install zoneinfo-asia to use the configured zone."
msgstr "当前配置的时区在本设备上没有 zoneinfo 数据，规则将退回使用系统时钟时区。请安装 zoneinfo-asia 以使用配置的时区。"

msgid "The conntrack utility is not installed, so flows of a newly blocked device expire on their own instead of being torn down."
msgstr "未安装 conntrack 工具，新被阻断设备的连接只能等待自然过期，不会被立即拆除。"

msgid "The device is registered in the device list as well."
msgstr "该设备同时会被登记到设备清单中。"

msgid "The devices NetControl keeps track of. A row here is a registration only: it writes no nftables rule, so the device keeps unrestricted access until a time rule governs it."
msgstr "NetControl 需要跟踪的设备。这里的每一行只是登记，不会生成 nftables 规则；在被时间规则纳管之前，设备的访问不受任何限制。"

msgid "The engine has not run an event yet, so no device is restricted."
msgstr "引擎尚未执行过任何事件，因此没有设备被限制。"

msgid "The evaluation loop is not running; the watchdog starts it again on its next round, and until then time rules change only on the backstop tick."
msgstr "评估循环未运行；看门狗会在下一轮把它重新启动，在此之前时间规则只按兜底心跳变化。"

msgid "The inet netcontrol table or its forward chain is missing. Reconcile to rebuild it."
msgstr "inet netcontrol 表或其 forward 链缺失。请点击“立即核对”重建。"

msgid "The inventory NetControl keeps track of. Listing a device here writes no kernel rule: its traffic stays unrestricted until a time rule governs it."
msgstr "NetControl 维护的设备清单。把设备列入清单不会写入任何内核规则：在被时间规则纳管之前，其流量始终不受限。"

msgid "The nftables utility is unavailable, so no rule can be enforced."
msgstr "nftables 工具不可用，无法执行任何规则。"

msgid "The request failed: %s"
msgstr "请求失败：%s"

msgid "The system clock is not synchronised yet, so time rules are paused."
msgstr "系统时钟尚未同步，时间规则已暂停。"

msgid "The time must be between 00:00 and 23:59."
msgstr "时间必须在 00:00 至 23:59 之间。"

msgid "This device is already in the list."
msgstr "该设备已在清单中。"

msgid "Thu"
msgstr "周四"

msgid "time rule"
msgstr "时间规则"

msgid "time rule (deleted)"
msgstr "时间规则（已删除）"

msgid "Time rules"
msgstr "时间规则"

msgid "Time Rules"
msgstr "时间规则"

msgid "Timezone"
msgstr "时区"

msgid "Tue"
msgstr "周二"

msgid "Type a MAC address, or pick one of the devices the router already knows."
msgstr "可直接输入 MAC 地址，也可从路由器已知的设备中选择。"

msgid "unknown error"
msgstr "未知错误"

msgid "Updated"
msgstr "更新时间"

msgid "Use HH:MM, e.g. 20:00."
msgstr "请使用 HH:MM，例如 20:00。"

msgid "UTC time"
msgstr "UTC 时间"

msgid "WARN"
msgstr "警告"

msgid "Watchdog interval"
msgstr "看门狗间隔"

msgid "Watchdog interval (minutes)"
msgstr "看门狗间隔（分钟）"

msgid "Wed"
msgstr "周三"

msgid "Weekly"
msgstr "每周"

msgid "Weekly: 1 = Mon … 7 = Sun. Monthly: a day of the month; a date a month does not have simply produces no event that month."
msgstr "每周：1=周一 … 7=周日。每月：选择几号；某个月没有该日期时，这个月就不产生事件。"

msgid "What the start time does. The end time does the opposite."
msgstr "开始时刻执行的动作。结束时刻执行相反动作。"

msgid "When disabled, automatic time rules are lifted while explicit manual blocks are preserved."
msgstr "关闭后解除自动时间规则，但保留显式的手动阻断。"

msgid "When two events of one device fall in the same minute, the ending one runs before the starting one; rules of the same kind run in the order shown here. Drag the handle to change that order."
msgstr "同一设备的两个事件落在同一分钟时，先执行“结束”再执行“开始”；同类规则按此处的顺序执行。拖动句柄可调整该顺序。"

msgid "Working…"
msgstr "处理中…"

msgid "Yes"
msgstr "是"

